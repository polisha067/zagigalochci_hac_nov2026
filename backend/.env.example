# Скопируйте в backend/.env: сервер читает его автоматически.
# Переменные окружения хостинга имеют приоритет над файлом.
APP_ENV=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:3000,http://127.0.0.1:8000
SESSION_TTL_SECONDS=604800
# По умолчанию база создаётся в backend/data/auth.sqlite3.
# DATABASE_PATH=/absolute/path/to/auth.sqlite3
# Тарифы расчёта по умолчанию синтетические: backend/examples/catalog.json.
# CALCULATION_CATALOG_PATH=/absolute/path/to/catalog.json
# Сеть хабов и грузовых услуг; по умолчанию синтетический пример.
# NETWORK_CATALOG_PATH=/absolute/path/to/network.json

# Локальный Ollama. Форма расчёта работает при выключенной модели
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=90

# file: тестовые письма в backend/data/outbox, реальной отправки нет.
# smtp: реальные письма через настроенный ниже сервер.
MAIL_BACKEND=file
MAIL_FROM=no-reply@example.com
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_PASSWORD=

# Для APP_ENV=production: обязательный постоянный секрет, минимум 32 символа.
# Сгенерировать: python -c 'import secrets; print(secrets.token_hex(32))'
# VERIFICATION_SECRET=
