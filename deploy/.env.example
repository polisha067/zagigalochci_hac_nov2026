# Copy to deploy/.env ON THE SERVER. Do not commit real values.
DOMAIN=your-domain.example
APP_ENV=production
COOKIE_SECURE=true
ALLOWED_ORIGINS=https://your-domain.example
# Generate ONCE: python3 -c 'import secrets; print(secrets.token_hex(32))'
VERIFICATION_SECRET=
MAIL_BACKEND=smtp
MAIL_FROM=logistics.notify@yandex.ru
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=logistics.notify@yandex.ru
SMTP_PASSWORD=
# Optional immutable image tag for the release, e.g. a Git commit id.
RELEASE_TAG=local
